# Copy this to backend/.env and fill real secrets. DO NOT commit backend/.env with real credentials.

# MongoDB
MONGO_URL="mongodb+srv://<DB_USER>:<DB_PASS>@cluster0.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="stepsolar"

# JWT secret used by the backend to sign tokens (generate with: openssl rand -hex 32)
JWT_SECRET="REPLACE_WITH_GENERATED_HEX_32_BYTES"

# Optional token expiry (minutes)
# JWT_EXPIRE_MINUTES=480

# Bootstrap admin — auto-seeded idempotently on first startup (skipped if a
# user with ADMIN_EMAIL already exists). The seed forces a password change on
# first login unless ADMIN_FORCE_PASSWORD_CHANGE=false. CHANGE THE PASSWORD
# AFTER THE FIRST LOGIN. Set ADMIN_EMAIL="" to disable seeding entirely.
# ADMIN_EMAIL="super@stepsolar.in"
# ADMIN_PASSWORD="Abhi@93047"
# ADMIN_NAME="Super Admin"
# ADMIN_ROLE="Admin"
# ADMIN_FORCE_PASSWORD_CHANGE=true
#
# LOST ADMIN PASSWORD? Set ADMIN_FORCE_RESET=true + ADMIN_PASSWORD to a known
# value and redeploy. On startup it overwrites the existing admin's password
# hash, then set ADMIN_FORCE_RESET=false afterwards.
# ADMIN_FORCE_RESET=false

# Duplicate guard window (minutes)
DUPLICATE_WINDOW_MIN=10

# Google Sheets (optional - leave blank to disable)
GOOGLE_SHEET_ID=""
# Either paste full JSON string here or put a path to the service account JSON
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Gmail SMTP (optional - leave blank to disable)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_TO="owner@example.com"
GMAIL_FROM_NAME="Step Solar"

# Optional test/admin token (useful for CI/tests only)
# STEPSOLAR_ADMIN_TOKEN="stepsolar-admin-change-me"

# --------------------------------------------------------------------------- #
# Custom WhatsApp Provider API (optional — leave CUSTOM_WHATSAPP_API_URL blank
# to disable; the whole feature no-ops cleanly and CRM keeps working)
#
# NOTE: An Admin can also set all of these at runtime from the CRM
# (Admin → "Inventory & WhatsApp" tab → WhatsApp Settings). Runtime values
# are stored in the Mongo `settings` collection and take precedence over the
# environment variables below — no redeploy needed.
# --------------------------------------------------------------------------- #
# Endpoint that receives the WhatsApp payload (POST, JSON). When unset the
# WhatsApp integration is disabled and every notify call is skipped + logged.
# CUSTOM_WHATSAPP_API_URL="https://your-provider.example.com/v1/messages"

# Secret sent in the auth header (optional). Default header is Authorization
# with a "Bearer <key>" value. Set WHATSAPP_AUTH_MODE=apikey to send the raw
# key instead, or WHATSAPP_AUTH_MODE=none to send no auth header at all.
# CUSTOM_WHATSAPP_API_KEY="change-me"
# WHATSAPP_API_KEY_HEADER="Authorization"
# WHATSAPP_AUTH_MODE="bearer"

# Business sender id / "from" number included in the payload as senderId.
# WHATSAPP_SENDER_ID="step-solar"

# Base URL used to build customer-facing tracking/quote links in messages.
# STEPSOLAR_BASE_URL="https://admin.stepsolar.in"

# OPTIONAL — exact JSON body the provider expects, with {{placeholder}}
# substitution. Placeholders: {{event}} {{lead_id}} {{lead_code}}
# {{customer_name}} {{phone}} {{sender_id}} {{timestamp}} {{stage_key}}
# {{stage_label}} {{message}} {{extra}} {{base_url}}. When unset a
# provider-agnostic default envelope is sent.
# WHATSAPP_PAYLOAD_TEMPLATE='{"type":"{{event}}","to":"{{phone}}","text":"{{message}}"}'

# Delivery behaviour (defaults are fine).
# WHATSAPP_MAX_ATTEMPTS=3
# WHATSAPP_REQUEST_TIMEOUT_SECONDS=10
