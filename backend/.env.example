# Copy this to backend/.env and fill real secrets. DO NOT commit backend/.env with real credentials.

# MongoDB
MONGO_URL="mongodb+srv://<DB_USER>:<DB_PASS>@cluster0.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="stepsolar"

# JWT secret used by the backend to sign tokens (generate with: openssl rand -hex 32)
JWT_SECRET="REPLACE_WITH_GENERATED_HEX_32_BYTES"

# Optional token expiry (minutes)
# JWT_EXPIRE_MINUTES=480

# Bootstrap admin — auto-seeded idempotently on first startup (skipped if a
# user with ADMIN_EMAIL already exists). The seed forces a password change on
# first login unless ADMIN_FORCE_PASSWORD_CHANGE=false. CHANGE THE PASSWORD
# AFTER THE FIRST LOGIN. Set ADMIN_EMAIL="" to disable seeding entirely.
# ADMIN_EMAIL="super@stepsolar.in"
# ADMIN_PASSWORD="Abhi@93047"
# ADMIN_NAME="Super Admin"
# ADMIN_ROLE="Admin"
# ADMIN_FORCE_PASSWORD_CHANGE=true
#
# LOST ADMIN PASSWORD? Set ADMIN_FORCE_RESET=true + ADMIN_PASSWORD to a known
# value and redeploy. On startup it overwrites the existing admin's password
# hash, then set ADMIN_FORCE_RESET=false afterwards.
# ADMIN_FORCE_RESET=false

# Duplicate guard window (minutes)
DUPLICATE_WINDOW_MIN=10

# Shared secret for GET /api/leads/lookup?phone=... — the WA bot
# (WaCrmStepSolar_Live) sends this back in the X-Service-Key header to
# check whether a lead already exists before starting the capture flow.
# Generate with: openssl rand -hex 24. Leave blank to disable the endpoint.
LEAD_LOOKUP_SERVICE_KEY="ek-random-strong-secret"

# Google Sheets (optional - leave blank to disable)
GOOGLE_SHEET_ID=""
# Either paste full JSON string here or put a path to the service account JSON
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Gmail SMTP (optional - leave blank to disable)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_TO="owner@example.com"
GMAIL_FROM_NAME="Step Solar"

# Optional test/admin token (useful for CI/tests only)
# STEPSOLAR_ADMIN_TOKEN="stepsolar-admin-change-me"

# --------------------------------------------------------------------------- #
# WaCrmStepSolar_Live (whatsapp.stepsolar.in) — POST /api/v1/messages
#
# URL defaults to the live WaCRM public API when CUSTOM_WHATSAPP_API_URL is
# omitted. Set it to empty to disable. Sends are still skipped until
# CUSTOM_WHATSAPP_API_KEY is set (create in WaCRM Settings → API keys,
# scope messages:send; the full key is shown once).
#
# An Admin can also set these at runtime from CRM → WhatsApp Settings
# (Mongo `settings` collection). Runtime values override env — no redeploy.
# --------------------------------------------------------------------------- #
CUSTOM_WHATSAPP_API_URL="https://whatsapp.stepsolar.in/api/v1/messages"
WHATSAPP_AUTH_MODE="bearer"
WHATSAPP_API_KEY_HEADER="Authorization"
# CUSTOM_WHATSAPP_API_KEY="wacrm_live_…"
#
# Optional override of the JSON body. Default (when unset) is the WaCRM
# schema: {"to":"<E.164>","type":"text","text":"…","name":"…"}.
# Placeholders: {{event}} {{lead_id}} {{lead_code}} {{customer_name}}
# {{phone}} {{sender_id}} {{timestamp}} {{stage_key}} {{stage_label}}
# {{message}} {{extra}} {{base_url}} {{media_url}} {{filename}}
# WHATSAPP_PAYLOAD_TEMPLATE='{"to":"{{phone}}","type":"text","text":"{{message}}","name":"{{customer_name}}"}'
#
# STEPSOLAR_BASE_URL="https://admin.stepsolar.in"
# WHATSAPP_SENDER_ID="step-solar"
#
# Optional inbox origin / key (defaults: strip /api/v1/messages from the
# provider URL, reuse CUSTOM_WHATSAPP_API_KEY). Used by GET contacts /
# conversations / messages for the in-CRM chat popup.
# WACRM_BASE_URL="https://whatsapp.stepsolar.in"
# WACRM_API_KEY="wacrm_live_…"

# Delivery behaviour (defaults are fine).
# WHATSAPP_MAX_ATTEMPTS=3
# WHATSAPP_REQUEST_TIMEOUT_SECONDS=10
